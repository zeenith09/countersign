{
  "name": "countersign",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --config tests/db/prisma.config.ts && next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-lint-boundaries.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run lint && npm run typecheck && node scripts/check-deps.mjs && npm test",
    "db:seed": "jiti prisma/seed.ts",
    "demo:agent": "jiti scripts/demo-agent.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov",
    "test:db": "RUN_DB_SPIKE=1 vitest run tests/db/transaction-spike.test.ts tests/db/audit-spike.test.ts tests/db/concurrency-integration.test.ts --no-file-parallelism"
  },
  "dependencies": {
    "@google/genai": "3.0.0",
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "unrs-resolver@1.12.2": true
  }
}
