generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ActionStatus {
  pending
  approved
  denied
  auto_allowed
  blocked

  @@map("action_status")
}

enum DecisionOutcome {
  approved
  denied

  @@map("decision_outcome")
}

model Action {
  id                String       @id @default(uuid()) @db.Uuid
  agentId           String       @map("agent_id")
  tool              String
  parameters        Json         @db.JsonB
  agentReasoning    String       @map("agent_reasoning") @db.Text
  status            ActionStatus @default(pending)
  policyRuleMatched String?      @map("policy_rule_matched")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  decision          Decision?

  @@index([status, createdAt])
  @@index([agentId, createdAt])
  @@map("actions")
}

model Decision {
  id               String          @id @default(uuid()) @db.Uuid
  actionId         String          @unique @map("action_id") @db.Uuid
  reviewer         String
  outcome          DecisionOutcome
  reason           String          @db.Text
  editedParameters Json?           @map("edited_parameters") @db.JsonB
  decidedAt        DateTime        @default(now()) @map("decided_at") @db.Timestamptz(6)
  action           Action          @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@index([reviewer, decidedAt])
  @@map("decisions")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  sequence  BigInt   @unique
  eventType String   @map("event_type")
  payload   Json     @db.JsonB
  prevHash  String?  @map("prev_hash") @db.Char(64)
  hash      String   @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([eventType, createdAt])
  @@map("audit_log")
}
