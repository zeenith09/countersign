# ─────────────────────────────────────────
# Application runtime — Neon development branch
# Pooled connection (-pooler hostname)
# ─────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@DEVELOPMENT-POOLER-HOST/DATABASE?sslmode=require"

# ─────────────────────────────────────────
# Prisma migrations — Neon development branch
# Direct connection (no -pooler hostname)
# ─────────────────────────────────────────
DIRECT_URL="postgresql://USER:PASSWORD@DEVELOPMENT-HOST/DATABASE?sslmode=require"

# ─────────────────────────────────────────
# Prisma migration shadow database
# Direct connection to the separate migration-shadow branch
# ─────────────────────────────────────────
SHADOW_DIRECT_URL="postgresql://USER:PASSWORD@SHADOW-HOST/DATABASE?sslmode=require"

# Explicit development database target for the seed script (to remind never touch prod)
SEED_DATABASE_URL="postgresql://USER:PASSWORD@DEVELOPMENT-POOLER-HOST/DATABASE?sslmode=require"

# ─────────────────────────────────────────
# Optional demo agent: configure a Gemini API key and a model available to your account.
# Use a development gateway: the demo stores submissions.
GEMINI_API_KEY=""
GEMINI_MODEL=""
DEMO_GATEWAY_URL="http://localhost:3000/api/actions"

# Optional database spike tests
# Isolated Neon spike branch — never production
# ─────────────────────────────────────────
SPIKE_DATABASE_URL="postgresql://USER:PASSWORD@SPIKE-POOLER-HOST/DATABASE?sslmode=require"
SPIKE_DIRECT_URL="postgresql://USER:PASSWORD@SPIKE-HOST/DATABASE?sslmode=require"

# CI forces this to 0; npm test skips the spike unless it is 1.
# To run on demand, first confirm the URLs target the isolated spike branch,
# export the desired SPIKE_* URL and generate the spike client:
#   npx prisma generate --config tests/db/prisma.config.ts
# Then run one mode at a time (the command sets RUN_DB_SPIKE=1):
#   SPIKE_DB_MODE=pooled npm run test:db
#   SPIKE_DB_MODE=direct npm run test:db
# Do not run these modes concurrently: they create and drop the same table.
RUN_DB_SPIKE="0"