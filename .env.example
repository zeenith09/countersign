# ─────────────────────────────────────────
# Application runtime — Neon development branch
# Pooled connection (-pooler hostname)
# ─────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@DEVELOPMENT-POOLER-HOST/DATABASE?sslmode=require"

# ─────────────────────────────────────────
# Prisma migrations — Neon development branch
# Direct connection (no -pooler hostname)
# ─────────────────────────────────────────
DIRECT_URL="postgresql://USER:PASSWORD@DEVELOPMENT-HOST/DATABASE?sslmode=require"

# ─────────────────────────────────────────
# Prisma migration shadow database
# Direct connection to the separate migration-shadow branch
# ─────────────────────────────────────────
SHADOW_DIRECT_URL="postgresql://USER:PASSWORD@SHADOW-HOST/DATABASE?sslmode=require"

# ─────────────────────────────────────────
# Optional database spike tests
# Isolated Neon spike branch — never production
# ─────────────────────────────────────────
SPIKE_DATABASE_URL="postgresql://USER:PASSWORD@SPIKE-POOLER-HOST/DATABASE?sslmode=require"
SPIKE_DIRECT_URL="postgresql://USER:PASSWORD@SPIKE-HOST/DATABASE?sslmode=require"

# Set to 1 only when intentionally running database spike tests
RUN_DB_SPIKE="0"